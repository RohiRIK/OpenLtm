{
  "description": "LTM hooks — context injection, session learning, progress capture, compaction snapshot, janitor on session end",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/bin/run-hook.sh\" \"${CLAUDE_PLUGIN_ROOT}/hooks/src/SessionStart.ts\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/bin/run-hook.sh\" \"${CLAUDE_PLUGIN_ROOT}/hooks/src/UpdateContext.ts\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/bin/run-hook.sh\" \"${CLAUDE_PLUGIN_ROOT}/hooks/src/EvaluateSession.ts\"",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/bin/run-hook.sh\" \"${CLAUDE_PLUGIN_ROOT}/hooks/src/SessionEnd.ts\""
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/bin/run-hook.sh\" \"${CLAUDE_PLUGIN_ROOT}/hooks/src/PreCompact.ts\""
          }
        ]
      }
    ]
  }
}
