{
  "name": "@rohirik/opencode-ltm",
  "version": "2.16.2",
  "description": "LTM (Long-Term Memory) plugin for OpenCode \u2014 share memories with Claude Code and Pi",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test",
    "prepack": "bun run ../../scripts/resolve-workspace-deps.ts rewrite package.json",
    "postpack": "bun run ../../scripts/resolve-workspace-deps.ts restore package.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/RohiRIK/OpenLtm"
  },
  "keywords": [
    "opencode",
    "ltm",
    "long-term-memory",
    "plugin"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@rohirik/openltm-core": "workspace:*",
    "zod": "^3.0.0"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.3.0",
    "bun-types": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "@opencode-ai/plugin": {
      "optional": true
    },
    "bun-types": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bun": "latest"
  }
}
