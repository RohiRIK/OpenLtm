{
  "name": "@rohirik/pi-ltm",
  "version": "2.23.0",
  "description": "Long-term memory extension for the Pi coding agent: persistent local SQLite memory with semantic recall, shared with Claude Code, OpenCode, OpenClaw and Hermes.",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "src"
  ],
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "scripts": {
    "build": "bunx esbuild src/index.ts --bundle --platform=node --format=esm --target=esnext --outfile=dist/index.js --external:bun:sqlite --external:bun:test --external:@rohirik/openltm-core --minify",
    "prepublishOnly": "bun run build",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test",
    "prepack": "bun run build && bun run ../../scripts/resolve-workspace-deps.ts rewrite package.json",
    "postpack": "bun run ../../scripts/resolve-workspace-deps.ts restore package.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/RohiRIK/OpenLtm"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "ltm",
    "long-term-memory",
    "extension",
    "ai-memory",
    "agent-memory",
    "llm-memory",
    "persistent-memory",
    "ai-agents",
    "sqlite",
    "semantic-search",
    "local-first"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@rohirik/openltm-core": "workspace:*"
  },
  "peerDependencies": {
    "bun-types": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "bun-types": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bun": "latest"
  }
}
