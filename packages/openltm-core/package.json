{
  "name": "@rohirik/openltm-core",
  "version": "2.23.0",
  "description": "Local long-term memory engine for AI coding agents: SQLite with full-text and vector search, an MCP server and a CLI. Powers OpenLTM for Claude Code, OpenCode, Pi, OpenClaw and Hermes.",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./cli": "./src/cli/index.ts",
    "./mcp": "./src/mcp/server.ts",
    "./package.json": "./package.json"
  },
  "bin": {
    "ltm": "src/cli/bin.ts",
    "openltm": "src/cli/bin.ts",
    "openltm-core": "src/cli/bin.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/RohiRIK/OpenLtm"
  },
  "keywords": [
    "ltm",
    "long-term-memory",
    "claude-code",
    "sqlite",
    "memory",
    "ai-memory",
    "agent-memory",
    "llm-memory",
    "persistent-memory",
    "ai-agents",
    "semantic-search",
    "local-first",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "fts5",
    "sqlite-vec",
    "embeddings",
    "rag",
    "llama-cpp",
    "coding-agent",
    "cli"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@clack/prompts": "^1.3.0",
    "@iarna/toml": "^2.2.5",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "bun-types": "^1.0.0",
    "sqlite-vec": "0.1.9",
    "zod": "^4.6.6"
  },
  "optionalDependencies": {
    "@russellthehippo/honker-bun": "^0.2.2"
  },
  "devDependencies": {
    "@types/node": "^20.0.0"
  }
}
